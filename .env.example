# Public URL of the site (used for metadata and the sitemap)
NEXT_PUBLIC_SITE_URL=https://luciagelato.com

# Adobe Fonts kit id for Sauna Pro + Oskar One (optional — free fallbacks are used without it)
NEXT_PUBLIC_ADOBE_FONTS_KIT_ID=

# Sanity — the content editor at /studio. Defaults to project kkqmc2m3 / production; set these only to override.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Shared secret for the publish webhook (/api/revalidate) so edits go live within seconds
SANITY_REVALIDATE_SECRET=
# Only needed to run `npm run seed` once; don't deploy it
SANITY_API_WRITE_TOKEN=

# Square — online checkout for pints & cakes, paid by card and/or Square gift cards.
# All three are needed; without them the cart offers "email my order".
# From developer.squareup.com → your app → Credentials (use the Sandbox tab to test) and Locations.
# Sandbox application ids start with "sandbox-", which also points the site at Square's sandbox.
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=

# Resend — delivers contact, events, wholesale and newsletter forms to the Lucia inbox.
# Without it, forms fall back to a prefilled email.
RESEND_API_KEY=
FORMS_TO_EMAIL=luciagelato@gmail.com
FORMS_FROM_EMAIL="Lucia Gelato website <website@luciagelato.com>"
